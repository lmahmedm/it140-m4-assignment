Guessing Game Pseudocode
# Behavior: ask for lower & upper bounds (lower < upper), generate random integer in [lower, upper],
# repeatedly prompt for a guess (validated to be between bounds) and tell user: too low / too high / correct.

MAIN:
  seed random number generator (optional, for languages that require it)

  # --- Get valid bounds ---
  LOOP until valid_bounds_obtained:
    prompt "Enter the LOWER bound (integer):"
    read input_lower_raw
    if input_lower_raw is not a valid integer:
      print "Invalid input. Please enter an integer."
      continue LOOP

    prompt "Enter the UPPER bound (integer):"
    read input_upper_raw
    if input_upper_raw is not a valid integer:
      print "Invalid input. Please enter an integer."
      continue LOOP

    lower <- integer value of input_lower_raw
    upper <- integer value of input_upper_raw

    if lower >= upper:
      print "Invalid range. The lower bound must be less than the upper bound. Try again."
      continue LOOP

    valid_bounds_obtained <- true

  # --- Generate random target ---
  target <- random integer between lower and upper inclusive

  # Optional: track attempts
  attempts <- 0

  # --- Guess loop ---
  LOOP forever:
    prompt "Guess a number between [lower] and [upper]:"
    read guess_raw

    if guess_raw is not a valid integer:
      print "Invalid input. Please enter an integer."
      continue LOOP

    guess <- integer value of guess_raw

    if guess < lower or guess > upper:
      print "Your guess must be between [lower] and [upper]. Try again."
      continue LOOP

    attempts <- attempts + 1

    if guess < target:
      print "Too low. Try again."
      # continue LOOP
    else if guess > target:
      print "Too high. Try again."
      # continue LOOP
    else:
      # guess == target
      print "Correct! You guessed the number", target, "in", attempts, "attempt(s)."
      break LOOP

  print "Game over. Thank you for playing."
END MAIN
